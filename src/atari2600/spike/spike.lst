       1/   0 :                         ; spike.asm -- FujiBlast Atari 2600 arena spike: a plain 4K image (no cart,
       2/   0 :                         ; no network) that draws a canned 13 x 11 arena, bomber 0 (player 0, steady)
       3/   0 :                         ; and three more bombers on player 1, moved between tile rows at the seams.
       4/   0 :                         ;
       5/   0 :                         ; Kernel = M.U.L.E.'s map loop: an ENTRY is two scanlines, line A updates
       6/   0 :                         ; player 0 and line B player 1, six playfield tables are read every line.
       7/   0 :                         ; Here a tile row is 7 entries; the seam before it clears the playfield and,
       8/   0 :                         ; on a row where player 1 changes bomber, takes two more lines to position it
       9/   0 :                         ; (coarse in SEAM1, HMOVE in SEAM2).  Tables stand in ROM for the cart's planes.
      10/   0 :                         ;
      11/   0 :                         ; Build: tools/a26/spike.sh [LOOK]
      12/   0 :                         
      13/   0 :                                 CPU     6502UNDOC
      14/   0 :                                 INCLUDE "../../../tools/a26/vcs.inc"
(1)    1/   0 :                         ; vcs.inc -- TIA and RIOT equates for Macroassembler AS.
(1)    2/   0 :                         ;
(1)    3/   0 :                         ; The 2600 world's standard vcs.h is a dasm companion file and is explicitly
(1)    4/   0 :                         ; "please do not redistribute", so this is written from the hardware register
(1)    5/   0 :                         ; map rather than copied. AS is the assembler the rest of this family already
(1)    6/   0 :                         ; uses -- the o2 (8048), arcadia (2650) and channelf (F8) ports all build with
(1)    7/   0 :                         ; it and CI already caches its build -- so the 2600 client joins them rather
(1)    8/   0 :                         ; than adding dasm as a seventh toolchain.
(1)    9/   0 :                         ;
(1)   10/   0 :                         ; The 6507 has thirteen address lines, so everything mirrors. These are the
(1)   11/   0 :                         ; canonical low addresses; TIA writes are $00-$2C, TIA reads $00-$0D, and the
(1)   12/   0 :                         ; RIOT sits at $0280 with its RAM at $0080.
(1)   13/   0 :                         
(1)   14/   0 :                         ; ---------------- TIA, write ----------------
(1)   15/   0 : =$0                     VSYNC   EQU     $00             ; bit 1: vertical sync
(1)   16/   0 : =$1                     VBLANK  EQU     $01             ; bit 1: blank, bit 6/7: input latch/dump
(1)   17/   0 : =$2                     WSYNC   EQU     $02             ; halt the CPU until the next scanline
(1)   18/   0 : =$3                     RSYNC   EQU     $03
(1)   19/   0 : =$4                     NUSIZ0  EQU     $04             ; player 0 copies / missile size
(1)   20/   0 : =$5                     NUSIZ1  EQU     $05
