; fujiblst.a48 -- FujiBlast for the Magnavox Odyssey 2 / Philips Videopac, on
; the FujiNet cartridge: a protocol 2 (APPBANK) image -- the fixed half
; ($400-$7FF: core.inc, st.inc and the text screens' overlay; the arena's
; is arena.a48, swapped in by p3.inc) and NPAGES pages of 2K, one
; assembly per page; build.sh sets PAGE.

    cpu 8048
    include "g7000.h"
    include "flags.inc"
    include "proto.inc"
    include "sprfr.inc"
    include "equ.inc"
    include "ram.inc"
    include "page.inc"
    include "core.inc"
    include "st.inc"
    include "ov_text.inc"
    include "arena_sym.inc"

    if PAGE=0
    include "p0.inc"
    elseif PAGE=1
    include "p1.inc"
    elseif PAGE=2
    include "p2.inc"
    elseif PAGE=3
    include "p3.inc"
    elseif PAGE=4
    include "p4.inc"
    elseif PAGE=5
    include "p5.inc"
    elseif PAGE=6
    include "p6.inc"
    elseif PAGE=7
    include "p7.inc"
    elseif PAGE=8
    include "p8.inc"
    elseif PAGE=9
    include "p9.inc"
    elseif PAGE=10
    include "p10.inc"
    elseif PAGE=11
    include "p11.inc"
    endif
