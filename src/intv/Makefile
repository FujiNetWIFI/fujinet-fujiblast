# FujiBlast for the Intellivision and the FujiNet cartridge (its mailbox at
# $9C00, its RAM at $8000-$9BFF). There is no C compiler for the CP1610, so
# these .bas files are the client again in IntyBASIC 1.5, which is built
# here from its source (IB_SRC, as syn-ack-wire's and M.U.L.E.'s are: the
# intybasic on PATH may be 1.4, which has no OPTION MAP). as1600 (on PATH)
# assembles; tools/intv/checkcfg.py fails a ROM that lands on the ECS's ROM,
# the cartridge's RAM or a GRAM mirror.
#
#   make -C src/intv              ../../r2r/intv/fujiblst.rom
#   make -C src/intv SERVER=h:p   the server used when the lobby gave none
#                                 (remembered in gen/server, as the others')
#   make -C src/intv TEST=0       without the offline test scenes
#   make -C src/intv rig          build/intv-rig/fujiblst.rom: for the rigs,
#                                 its default server 127.0.0.1:9910 (gen/server
#                                 untouched)

ROOT   := $(abspath ../..)
B      ?= $(ROOT)/build/intv
GEN    ?= $(ROOT)/gen/intv
R2R    ?= $(ROOT)/r2r/intv
DEFSRV ?=
IB_SRC ?= $(HOME)/Workspace/IntyBASIC
IB     := $(ROOT)/build/intybasic
AS1600 ?= as1600
PYTHON ?= python3
TEST   ?= 1

BAS  := $(wildcard *.bas)
ASMS := $(wildcard *.asm)
GENS := $(GEN)/proto.bas $(GEN)/config.bas $(GEN)/gfx.bas $(GEN)/snd.bas $(GEN)/opts.bas
ROM  := $(R2R)/fujiblst.rom

all: $(ROM)

$(IB)/intybasic: $(wildcard $(IB_SRC)/*.cpp $(IB_SRC)/*.h)
	@mkdir -p $(IB)
	$(CXX) -O2 -o $@ $(IB_SRC)/node.cpp $(IB_SRC)/microcode.cpp $(IB_SRC)/code.cpp $(IB_SRC)/IntyBASIC.cpp
# 1.5.2's prologue has a comment written with ' (line 251), which as1600 rejects
$(IB)/intybasic_prologue.asm: $(IB_SRC)/intybasic_prologue.asm
	@mkdir -p $(IB)
	sed "s/  ' Max internal index/  ; Max internal index/" $< > $@
$(IB)/intybasic_epilogue.asm: $(IB_SRC)/intybasic_epilogue.asm
	@mkdir -p $(IB)
	cp $< $@

# the server's constants (src/proto.h, from `fujiblastd -cheader`)
$(GEN)/proto.bas: $(ROOT)/src/proto.h
	@mkdir -p $(GEN)
	{ echo "' GENERATED from src/proto.h by src/intv/Makefile."; \
	  sed -n 's/^#define \([A-Z0-9_]*\) *\([0-9][0-9]*\)$$/    CONST \1 = \2/p' $<; } > $@

# the server used when the lobby gave none (as the other platforms': gen/server)
$(GEN)/config.bas: FORCE
	@mkdir -p $(GEN)
	@if [ -n "$(SERVER)" ]; then echo "$(SERVER)" > $(ROOT)/gen/server.new; \
	  cmp -s $(ROOT)/gen/server.new $(ROOT)/gen/server || mv $(ROOT)/gen/server.new $(ROOT)/gen/server; \
	  rm -f $(ROOT)/gen/server.new; fi
	@[ -f $(ROOT)/gen/server ] || echo "localhost:9910" > $(ROOT)/gen/server
	@{ echo "' GENERATED by src/intv/Makefile: the default server, in ASCII, 0 ended."; \
	  printf "default_srv:\n    DATA "; \
	  printf '%s' "$(if $(DEFSRV),$(DEFSRV),$$(cat $(ROOT)/gen/server))" | od -An -tu1 -v | tr -s ' \n' ',' | sed 's/^,//'; \
	  echo "0"; } > $@.new
	@cmp -s $@.new $@ || mv $@.new $@
	@rm -f $@.new

$(GEN)/opts.bas: FORCE
	@mkdir -p $(GEN)
	@echo "    CONST WITH_TEST = $(TEST)" > $@.new
	@cmp -s $@.new $@ || mv $@.new $@
	@rm -f $@.new

$(GEN)/gfx.bas: $(ROOT)/tools/mkgfx_intv.py $(ROOT)/tools/png.py $(wildcard $(ROOT)/gfx/intv/*.png)
	@mkdir -p $(GEN)
	$(PYTHON) $(ROOT)/tools/mkgfx_intv.py $(GEN)

$(GEN)/snd.bas: $(ROOT)/tools/mksnd_intv.py $(ROOT)/src/apple2/sndtab.s
	@mkdir -p $(GEN)
	$(PYTHON) $(ROOT)/tools/mksnd_intv.py $(ROOT)/src/apple2/sndtab.s $@

# IntyBASIC looks for INCLUDEs in the folder it runs in: the sources and the
# generated files are copied there
$(B)/fujiblst.asm: $(BAS) $(ASMS) $(GENS) $(IB)/intybasic $(IB)/intybasic_prologue.asm $(IB)/intybasic_epilogue.asm
	@mkdir -p $(B)
	cp $(BAS) $(ASMS) $(GENS) $(B)/
	cd $(B) && $(IB)/intybasic main.bas fujiblst.asm $(IB)/ 2>&1 | grep -v '^Warning' | tee intybasic.log
	@! grep -q -i 'error' $(B)/intybasic.log || { rm -f $@; exit 1; }

# the .bin and .cfg only for checkcfg (the .cfg is the memory map)
$(ROM): $(B)/fujiblst.asm $(ROOT)/tools/intv/checkcfg.py
	cd $(B) && $(AS1600) -o fujiblst.bin -l fujiblst.lst fujiblst.asm
	$(PYTHON) $(ROOT)/tools/intv/checkcfg.py $(B)/fujiblst.cfg
	@mkdir -p $(R2R)
	cd $(B) && $(AS1600) -o $(ROM) -s $(R2R)/fujiblst.sym fujiblst.asm
	@echo "$@: $$(stat -c %s $@) bytes"

rig:
	$(MAKE) B=$(ROOT)/build/intv-rig/obj GEN=$(ROOT)/build/intv-rig/gen R2R=$(ROOT)/build/intv-rig \
	    DEFSRV=127.0.0.1:9910

clean:
	rm -rf $(B) $(GEN) $(R2R) $(ROOT)/build/intv-rig

.PHONY: all clean rig FORCE
