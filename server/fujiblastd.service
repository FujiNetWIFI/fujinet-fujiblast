# systemd unit for the FujiBlast server: the game's stream on TCP 9910
# (FujiNet netstream) -- open it.
#
# Install:
#   go build -o fujiblastd ./cmd/fujiblastd
#   sudo mkdir -p /srv/fujiblast && sudo cp fujiblastd /srv/fujiblast/
#   sudo cp fujiblastd.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fujiblastd
[Unit]
Description=FujiBlast server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/srv/fujiblast
ExecStart=/srv/fujiblast/fujiblastd
Environment=FUJIBLAST_STREAM_ADDR=:9910
# House bots per public table (default blast1=1,blast2=2,blast3=3; empty: none).
#Environment=FUJIBLAST_BOTS=blast1=1,blast2=2,blast3=3
# Lobby listing (lobby key 16): off unless FUJIBLAST_LOBBY is qa, prod or a URL.
#Environment=FUJIBLAST_LOBBY=qa
#Environment=FUJIBLAST_SERVER_URL=tcp://fujinet.online:9910/
#Environment=FUJIBLAST_CLIENT_ATARI=tnfs://fujinet.online/fujiblast/atari/fujiblst.atr
#Environment=FUJIBLAST_CLIENT_APPLE2=tnfs://fujinet.online/fujiblast/apple2/fujiblst.po
#Environment=FUJIBLAST_CLIENT_MSDOS=tnfs://fujinet.online/fujiblast/msdos/fujiblst.img
#Environment=FUJIBLAST_CLIENT_INTV=tnfs://fujinet.online/fujiblast/intv/fujiblst.rom
#Environment=FUJIBLAST_CLIENT_ADAM=tnfs://fujinet.online/fujiblast/adam/fujiblst.ddp
#Environment=FUJIBLAST_CLIENT_O2=tnfs://fujinet.online/fujiblast/o2/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_ARCADIA=tnfs://fujinet.online/fujiblast/arcadia/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_ASTROCADE=tnfs://fujinet.online/fujiblast/astrocade/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_COLECO=tnfs://fujinet.online/fujiblast/coleco/fujiblst.col
#Environment=FUJIBLAST_CLIENT_ATARI7800=tnfs://fujinet.online/fujiblast/atari7800/fujiblst.a78
#Environment=FUJIBLAST_CLIENT_ATARI5200=tnfs://fujinet.online/fujiblast/atari5200/fujiblst.a52
DynamicUser=yes
Restart=on-failure
RestartSec=5
# fujiblastd posts "offline" to the lobby on SIGTERM: give it the time
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
