# systemd unit for the FujiBlast server: the game's stream on TCP 9910
# (FujiNet netstream) -- open it.
#
# Install:
#   go build -o fujiblastd ./cmd/fujiblastd
#   sudo mkdir -p /srv/fujiblast && sudo cp fujiblastd /srv/fujiblast/
#   sudo cp fujiblastd.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now fujiblastd
[Unit]
Description=FujiBlast server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/srv/fujiblast
ExecStart=/srv/fujiblast/fujiblastd
Environment=FUJIBLAST_STREAM_ADDR=:9910
# House bots per public table (default blast1=1,blast2=2,blast3=3; empty: none).
#Environment=FUJIBLAST_BOTS=blast1=1,blast2=2,blast3=3
# Lobby listing (lobby key 16): off unless FUJIBLAST_LOBBY is qa, prod or a URL.
#Environment=FUJIBLAST_LOBBY=qa
#Environment=FUJIBLAST_SERVER_URL=tcp://fujinet.online:9910/
#Environment=FUJIBLAST_CLIENT_ATARI=tnfs://apps.irata.online/fujiblast/atari/fujiblst.atr
#Environment=FUJIBLAST_CLIENT_APPLE2=tnfs://apps.irata.online/fujiblast/apple2/fujiblst.po
#Environment=FUJIBLAST_CLIENT_MSDOS=tnfs://apps.irata.online/fujiblast/msdos/fujiblst.img
#Environment=FUJIBLAST_CLIENT_INTV=tnfs://apps.irata.online/fujiblast/intv/fujiblst.rom
#Environment=FUJIBLAST_CLIENT_ADAM=tnfs://apps.irata.online/fujiblast/adam/fujiblst.ddp
#Environment=FUJIBLAST_CLIENT_O2=tnfs://apps.irata.online/fujiblast/odyssey2/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_ARCADIA=tnfs://apps.irata.online/fujiblast/arcadia/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_ATARI2600=tnfs://apps.irata.online/fujiblast/atari-2600/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_ASTROCADE=tnfs://apps.irata.online/fujiblast/astrocade/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_CHANNELF=tnfs://apps.irata.online/fujiblast/channelf/fujiblst.bin
#Environment=FUJIBLAST_CLIENT_COLECO=tnfs://apps.irata.online/fujiblast/coleco/fujiblst.col
#Environment=FUJIBLAST_CLIENT_ATARI7800=tnfs://apps.irata.online/fujiblast/atari-7800/fujiblst.a78
#Environment=FUJIBLAST_CLIENT_ATARI5200=tnfs://apps.irata.online/fujiblast/atari-5200/fujiblst.a52
#Environment=FUJIBLAST_CLIENT_COCO=tnfs://apps.irata.online/fujiblast/coco/fujiblst.dsk
#Environment=FUJIBLAST_CLIENT_NES=tnfs://apps.irata.online/fujiblast/nes/fujiblst.nes
#Environment=FUJIBLAST_CLIENT_SMS=tnfs://apps.irata.online/fujiblast/sms/fujiblst.sms
#Environment=FUJIBLAST_CLIENT_H89=tnfs://apps.irata.online/fujiblast/h89/fujiblst-cpm.h8d
#Environment=FUJIBLAST_CLIENT_MSX=tnfs://apps.irata.online/fujiblast/msx/fujiblst[ASCII8].rom
#Environment=FUJIBLAST_CLIENT_STUDIO2=tnfs://apps.irata.online/fujiblast/studio2/fujiblst.st2
DynamicUser=yes
Restart=on-failure
RestartSec=5
# fujiblastd posts "offline" to the lobby on SIGTERM: give it the time
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
